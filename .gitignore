# ==============================================================================
# BATWA Monorepo Git Ignore
# ==============================================================================

# OS & IDE metadata
.DS_Store
Thumbs.db
.idea/
*.iml
*.ipr
*.iws

# Root temporary scratch scripts & logs
/*.js
/*.txt
/*.json
/*.exe
/*.png
dist_website/
*.zip

# Website temporary & packages
website/node_modules/
website/batwa-wallet-v1.0.0.apk

# Mobile (Flutter / Android / iOS)
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/.gradle/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/*.env
mobile/.env

# Backend (Spring Boot / Maven)
backend/target/
backend/*.log
backend/*.mv.db
backend/batwa_data.trace.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Netlify folder
.netlify
